# Next experiment: maximize useful GPU/KV occupancy (not a 10-task sweep).
#
# Evidence so far (think1b / pilots):
#   - nvidia-smi often ~100% while decoding, but mean Running ≈ 3 of n=5
#   - KV usage only ~3–11% at n=5; Waiting always 0 → client under-feeds vLLM
#   - Peak prompts ~100–147K ≪ 256K reserved pool
#   - Agents idle the GPU during Docker/tool phases → overlap two Harbor jobs
#
# Design:
#   - thinking=high (best F2P so far)
#   - 2 concurrent Harbor tasks (TASK_PARALLEL=2)
#   - each: pass@5 with n=5 → peak 10 in-flight requests
#   - max_num_seqs=10 (match peak; do not leave headroom that queues for no reason)
#   - keep 256K/TP4 this round (known-good); shrink context only after KV% rises
#
#   set -a && source configs/models/qwen3.5-9b-kvpack-think-high.env.example && set +a
#   export SYSML_NERSC_USER=<user>
#   export SYSML_REMOTE_ROOT=/pscratch/sd/<letter>/<user>/sysml_parallel_tvcache
#   # Terminal/screen:
#   bash scripts/run_experiment.sh none
#
# If Docker bind races: set SYSML_HARBOR_N=4 and SYSML_MAX_NUM_SEQS=8 (2×4).

export SYSML_MODEL_ID=Qwen/Qwen3.5-9B
export MODEL=openai/Qwen/Qwen3.5-9B

export SYSML_MAX_MODEL_LEN=262144
export SYSML_CONTEXT_WINDOW=262144
export SYSML_MAX_TOKENS=32768
export SYSML_MAX_TURNS=250
export SYSML_THINKING=high

export SYSML_PASS_K=5
export SYSML_HARBOR_N=5
export SYSML_MAX_NUM_SEQS=10
export SYSML_TASK_PARALLEL=2

export SYSML_GPUS=4
export SYSML_TENSOR_PARALLEL_SIZE=4
export SYSML_CPUS_PER_TASK=128
export SYSML_MEM=220G
export SYSML_GPU_MEMORY_UTILIZATION=0.90
export SYSML_SLURM_QOS=interactive
export SYSML_ALLOC_TIME=04:00:00
# Both tasks share one alloc (parallel batch of 2).
export SYSML_TASKS_PER_ALLOC=2
export SYSML_SERVE_WAIT_ITERS=480

export SYSML_TASK_LIST=configs/experiment-tasks-kvpack-pilot.txt

export SYSML_TOOL_CALL_PARSER=qwen3_coder
export SYSML_VLLM_EXTRA_ARGS='--reasoning-parser qwen3 --language-model-only'
export PI_VERSION=1.4.0
export SYSML_ALLOW_AGENT_EGRESS=1

export SYSML_JOB_PREFIX=char-kvpack-think-high-n10
export SYSML_TUNNEL_LOCAL_PORT=18090

export OPENAI_API_KEY=EMPTY
export OPENAI_BASE_URL=http://127.0.0.1:18081/v1
