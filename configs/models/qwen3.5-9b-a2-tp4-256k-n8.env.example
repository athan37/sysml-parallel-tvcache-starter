# Experiment A cell A2 — sized from pilot1 (char-pilot1-clack-t500, 2026-11-02).
#
# Pilot evidence (1 task × 5 rollouts, clack):
#   turns min/med/max = 66 / 118 / 194  (all finished with clean stop; 500 was excess)
#   max prompt tokens max = 146967      (keep 256K; 128K would be too small)
#   max_tokens=16384: only 1 truncation hit the cap
#   vLLM KV ~6–9% at n=5 → raise concurrent rollouts for throughput
#   nvidia-smi util often ~100% while decoding; memory ~37.5/40 GiB reserved
#
# Throughput-oriented full-wave defaults below. Override SYSML_TASK_LIST if needed.
#
#   set -a && source configs/models/qwen3.5-9b-a2-tp4-256k-n8.env.example && set +a
#   export SYSML_NERSC_USER=<user>
#   export SYSML_REMOTE_ROOT=/pscratch/sd/<letter>/<user>/sysml_parallel_tvcache
#   bash scripts/run_experiment.sh none

export SYSML_MODEL_ID=Qwen/Qwen3.5-9B
export MODEL=openai/Qwen/Qwen3.5-9B

export SYSML_MAX_MODEL_LEN=262144
export SYSML_CONTEXT_WINDOW=262144
export SYSML_MAX_TOKENS=16384
# 194 * 1.25 ≈ 240; use 250 for headroom across other tasks
export SYSML_MAX_TURNS=250
export SYSML_THINKING=off

# More concurrent rollouts (KV headroom); k stays 5 for pass@5, or raise k with n
export SYSML_PASS_K=5
export SYSML_HARBOR_N=8
export SYSML_MAX_NUM_SEQS=8

export SYSML_GPUS=4
export SYSML_TENSOR_PARALLEL_SIZE=4
export SYSML_CPUS_PER_TASK=128
export SYSML_MEM=220G
export SYSML_GPU_MEMORY_UTILIZATION=0.90
export SYSML_SLURM_QOS=interactive
export SYSML_ALLOC_TIME=04:00:00
# ~1.3h per task at n=5 on pilot → keep 1–2 tasks/alloc; start with 1 if n=8 is slower
export SYSML_TASKS_PER_ALLOC=1
export SYSML_SERVE_WAIT_ITERS=480

# Full 10-task list (default). For a 3-task smoke first, override:
#   export SYSML_TASK_LIST=configs/experiment-tasks-a2-pilot1.txt
# export SYSML_TASK_LIST=configs/experiment-tasks.txt

export SYSML_TOOL_CALL_PARSER=qwen3_coder
export SYSML_VLLM_EXTRA_ARGS='--reasoning-parser qwen3 --language-model-only'
export PI_VERSION=1.4.0
export SYSML_ALLOW_AGENT_EGRESS=1

export SYSML_JOB_PREFIX=char-setup-10t-ctx256k-t250-n8
export SYSML_TUNNEL_LOCAL_PORT=18088

export OPENAI_API_KEY=EMPTY
export OPENAI_BASE_URL=http://127.0.0.1:18081/v1
