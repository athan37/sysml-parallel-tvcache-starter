# Copy to an ignored local file before a live wave.
# Proven Exp A cell (2026-11-01, char-setup-10t-k5): k=n=seqs=5, util=0.80, no OOM on A100-80GB.

export SYSML_MODEL_ID=Qwen/Qwen3.5-9B
export SYSML_MAX_MODEL_LEN=8192
export SYSML_CONTEXT_WINDOW=8192
export SYSML_MAX_TOKENS=2048
# Leave headroom for KV when max_num_seqs matches pass@k concurrency.
export SYSML_GPU_MEMORY_UTILIZATION=0.80
export SYSML_MAX_NUM_SEQS=5
export SYSML_PASS_K=5
export SYSML_HARBOR_N=5
# Qwen3.5 tool parser (not hermes). Requires a Qwen3.5-capable vLLM build.
export SYSML_TOOL_CALL_PARSER=qwen3_coder
# Required for DeepSWE text-only: skip vision encoder (avoids encoder-init hang on A100).
export SYSML_VLLM_EXTRA_ARGS='--reasoning-parser qwen3 --language-model-only'

export MODEL=openai/Qwen/Qwen3.5-9B
export OPENAI_API_KEY=EMPTY
# Harbor Pi custom endpoint → agent-local model relay (LoopbackPi listens on 18081).
export OPENAI_BASE_URL=http://127.0.0.1:18081/v1

export PI_VERSION=1.4.0
export SYSML_MAX_TURNS=8
export SYSML_THINKING=off
export SYSML_ALLOW_AGENT_EGRESS=1
export SYSML_TASKS_PER_ALLOC=2

# Task list for the wave (override only if you intentionally shrink/expand):
#   configs/experiment-tasks.txt  →  variants/deep-swe-setup/tasks/<id>/
# Single-task smoke (run_one.sh) may still set:
# export SYSML_TASK_ID=clack-async-autocomplete-options
# export SYSML_TASK_PATH=variants/deep-swe-setup/tasks/$SYSML_TASK_ID

# Fresh per allocation (filled by run_harbor_wave.sh / bridge_up):
# export SYSML_ALLOC_NODE=PLACEHOLDER_nidXXXXXX
# export SYSML_TUNNEL_LOCAL_PORT=18086
# export SYSML_COMPOSE_OVERLAY=PLACEHOLDER_.local-smoke/m4999-JOBID-compose.json
