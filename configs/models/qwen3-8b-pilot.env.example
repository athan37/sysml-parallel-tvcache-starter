# Legacy / alternate model example. Prefer configs/models/qwen3.5-9b-pilot.env.example.
# Keep concurrency knobs aligned with the 9B Exp A cell (pass@k = Harbor n = vLLM seqs).

export SYSML_MODEL_ID=Qwen/Qwen3-8B
export SYSML_MAX_MODEL_LEN=8192
export SYSML_CONTEXT_WINDOW=8192
export SYSML_MAX_TOKENS=2048
export SYSML_GPU_MEMORY_UTILIZATION=0.80
export SYSML_MAX_NUM_SEQS=5
export SYSML_PASS_K=5
export SYSML_HARBOR_N=5
export SYSML_TOOL_CALL_PARSER=hermes
export MODEL=openai/Qwen/Qwen3-8B
export OPENAI_API_KEY=EMPTY
export OPENAI_BASE_URL=http://127.0.0.1:18081/v1
