# Parallel-turn verification vs ranked_by_parallel.pdf (other codebase).
# Stock DeepSWE tasks, 1 trial × 8 turns — not setup variants / not Exp A A0.
#
# PDF label: "Qwen3-4B-Instruct (MLX)". Closest HF id for vLLM:
#   Qwen/Qwen3-4B-Instruct-2507
#
# Required (your paths):
#   export SYSML_NERSC_USER=<user>
#   export SYSML_REMOTE_ROOT=/pscratch/sd/<letter>/<user>/sysml_parallel_tvcache
#   export SYSML_SSH_HOST=perlmutter SYSML_SLURM_ACCOUNT=m4999
#
# Then:
#   set -a && source configs/models/qwen3-4b-instruct-parallel-verify.env.example && set +a
#   bash scripts/run_experiment.sh none
#   bash scripts/analyze_characterization_wave.sh "$SYSML_JOB_PREFIX"

export SYSML_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
export MODEL=openai/Qwen/Qwen3-4B-Instruct-2507
export SYSML_MAX_MODEL_LEN=8192
export SYSML_CONTEXT_WINDOW=8192
export SYSML_MAX_TOKENS=2048
export SYSML_GPU_MEMORY_UTILIZATION=0.80
export SYSML_MAX_NUM_SEQS=1
export SYSML_PASS_K=1
export SYSML_HARBOR_N=1
export SYSML_GPUS=1
export SYSML_TENSOR_PARALLEL_SIZE=1
export SYSML_TOOL_CALL_PARSER=hermes
# Instruct-2507 is non-thinking; keep parser minimal.
unset SYSML_VLLM_EXTRA_ARGS || true

export OPENAI_API_KEY=EMPTY
export OPENAI_BASE_URL=http://127.0.0.1:18081/v1
export PI_VERSION=1.4.0
export SYSML_MAX_TURNS=8
export SYSML_THINKING=off
export SYSML_ALLOW_AGENT_EGRESS=1
export SYSML_TASKS_PER_ALLOC=5
export SYSML_TASK_PARALLEL=1
export SYSML_SLURM_QOS=shared_interactive

export SYSML_JOB_PREFIX=verify-4b-stock-k1
export SYSML_TUNNEL_LOCAL_PORT=18087
export SYSML_TASK_LIST="$(pwd)/configs/experiment-tasks-parallel-verify.txt"
export SYSML_TASK_ROOT="$(pwd)/variants/deep-swe-stock/tasks"
