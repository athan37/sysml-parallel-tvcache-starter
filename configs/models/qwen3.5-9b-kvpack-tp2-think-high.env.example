# TP=2 occupancy pilot — same agent knobs as kvpack-think-high, half the TP.
#
# Compare to TP=4 think1b / kvpack:
#   - thinking=high, 256K ctx, max_tokens=32K, turns=250
#   - 2 concurrent Harbor tasks × pass@5 (n=5) → peak 10 in-flight
#   - max_num_seqs=10
#   - GPUS=2 / TP=2 (decide TP for 10-task sweep from this cell)
#
#   set -a && source configs/models/qwen3.5-9b-kvpack-tp2-think-high.env.example && set +a
#   export SYSML_NERSC_USER=<user>
#   export SYSML_REMOTE_ROOT=/pscratch/sd/<letter>/<user>/sysml_parallel_tvcache
#   # Terminal/screen (prefer over Cursor nohup):
#   screen -dmS sysml-tp2 bash -lc 'set -a && source configs/models/qwen3.5-9b-kvpack-tp2-think-high.env.example && set +a && export SYSML_NERSC_USER=... SYSML_REMOTE_ROOT=... && bash scripts/run_experiment.sh none'
#
# If serve OOMs at 256K×TP2: drop SYSML_GPU_MEMORY_UTILIZATION to 0.85, then
# shorten max_model_len only if still needed.
# Mac Docker (this host): 2× Harbor with N=5 hits bind/subnet races; proven overlap is
# clack N=5 + at most one extra N=1 sandbox. Prefer TASK_PARALLEL=1 for N=5, or
# TASK_PARALLEL=2 with N<=3 after `docker network prune` + Docker Desktop restart
# (daemon.json default-address-pools 172.20.0.0/12 size 24 written; needs restart).

export SYSML_MODEL_ID=Qwen/Qwen3.5-9B
export MODEL=openai/Qwen/Qwen3.5-9B

export SYSML_MAX_MODEL_LEN=262144
export SYSML_CONTEXT_WINDOW=262144
export SYSML_MAX_TOKENS=32768
export SYSML_MAX_TURNS=250
export SYSML_THINKING=high

export SYSML_PASS_K=5
export SYSML_HARBOR_N=5
export SYSML_MAX_NUM_SEQS=10
export SYSML_TASK_PARALLEL=2
# Delay second Harbor job so Docker can finish first task's N compose binds/networks.
export SYSML_TASK_STAGGER_SEC=90

export SYSML_GPUS=2
export SYSML_TENSOR_PARALLEL_SIZE=2
export SYSML_CPUS_PER_TASK=64
export SYSML_MEM=120G
export SYSML_GPU_MEMORY_UTILIZATION=0.90
# 2-GPU interactive is usually enough; fall back to shared_interactive if queued.
export SYSML_SLURM_QOS=interactive
export SYSML_ALLOC_TIME=04:00:00
export SYSML_TASKS_PER_ALLOC=2
export SYSML_SERVE_WAIT_ITERS=480

export SYSML_TASK_LIST=configs/experiment-tasks-kvpack-pilot.txt

export SYSML_TOOL_CALL_PARSER=qwen3_coder
export SYSML_VLLM_EXTRA_ARGS='--reasoning-parser qwen3 --language-model-only'
export PI_VERSION=1.4.0
export SYSML_ALLOW_AGENT_EGRESS=1

export SYSML_JOB_PREFIX=char-kvpack-tp2-think-high-n10
export SYSML_TUNNEL_LOCAL_PORT=18091

export OPENAI_API_KEY=EMPTY
export OPENAI_BASE_URL=http://127.0.0.1:18081/v1
