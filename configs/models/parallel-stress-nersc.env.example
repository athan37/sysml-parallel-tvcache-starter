# Forced-parallel stress on NERSC + vLLM (NOT Exp A characterization).
# Requires setup variants already built for ids in experiment-tasks-parallel-stress.txt.
#
#   export SYSML_NERSC_USER=<user>
#   export SYSML_REMOTE_ROOT=/pscratch/sd/<letter>/<user>/sysml_parallel_tvcache
#   export SYSML_SSH_HOST=perlmutter SYSML_SLURM_ACCOUNT=m4999
#   set -a && source configs/models/qwen3.5-9b-pilot.env.example && set +a
#   set -a && source configs/models/parallel-stress-nersc.env.example && set +a
#   bash scripts/run_experiment.sh none
#   bash scripts/analyze_characterization_wave.sh "$SYSML_JOB_PREFIX"

export SYSML_PARALLEL_STRESS=1
export SYSML_PREPARE=1
export SYSML_JOB_PREFIX=stress-nersc-parallel
# Optional overrides:
# export SYSML_AGENT=parallel_tvcache.evaluation.multitool_pi:MultitoolLoopbackPi
# export SYSML_TASK_LIST="$(pwd)/configs/experiment-tasks-parallel-stress.txt"
# export SYSML_TASK_ROOT="$(pwd)/variants/deep-swe-parallel-stress/tasks"
