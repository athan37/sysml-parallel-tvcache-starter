# Run `cp configs/example.env .env` and edit locally (do not commit .env).
# Model slug must be provider/model-id, e.g. openai/<provider-model>.
MODEL=openai/Qwen/Qwen3.5-9B

# Harbor Pi custom OpenAI-compatible endpoint (LoopbackPi agent relay).
# Required whenever you pass --ak model_api=openai-completions.
# run_harbor_wave.sh exports these for you; set them if you wrap harbor yourself.
OPENAI_API_KEY=EMPTY
OPENAI_BASE_URL=http://127.0.0.1:18081/v1

# Optional local smoke via scripts/run_one.sh (not the Exp A wave path):
# HARBOR_MODEL_BASE_URL=http://127.0.0.1:18081/v1
# HARBOR_MODEL_API_KEY_NAME=OPENAI_API_KEY
# HARBOR_PI_MODEL_API=openai-completions
TASK_ID=clack-async-autocomplete-options
PI_VERSION=1.4.0
